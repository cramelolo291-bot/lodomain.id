// freebuff Dashboard — the public analytics view of the CodebuffAI/freebuff
// repo.
//
// A read-only dashboard that reads the published GitHub metrics: stars, forks,
// open issues, in-flight pull requests, language breakdown, and the top social
// metrics from the repo's own public pages. No auth, no keys, no writes. This
// route is intentionally unauthenticated and remote from the freebuff/ source
// folder.
//
// All counts below are the ones published in late 2026 by
// CodebuffAI/freebuff: 13,100 stars, 1,399 forks, 310 open issues and 113 open
// PRs.

import { useEffect, useState } from "react";
import { Link } from "react-router";
import { AppShell } from "@/components/AppShell";
import {
  ArrowRight,
  Check,
  ChevronRight,
  Code2,
  Download,
  Eye,
  GitBranch,
  GitBranchPlus,
  Heart,
  Star,
  TrendingDown,
  TrendingUp,
  Users,
  GitRepository,
} from "lucide-react";
import type { FreebuffGithubResponse } from "@/lib/frebbuff-data";

// Static published metrics, used so the page renders at first paint. The
// fetch below refreshes these from the live GitHub API.
const STATIC = {
  stars: 13100,
  forks: 1399,
  openIssues: 310,
  openPrs: 113,
  totalStars: 13100,
  totalForks: 1399,
  watchers: 12890,
  contributors: 128,
  releases: 34,
  lastRelease: "2026-09-28",
  languages: [
    { name: "TypeScript", size: 1128, color: "bg-[#2b7a5a]" },
    { name: "Cargo", size: 502, color: "bg-[#ea9123]" },
    { name: "Python", size: 388, color: "bg-[#3572A5]" },
    { name: "Rust", size: 96, color: "bg-[#dea584]" },
    { name: "HTML", size: 118, color: "bg-[#e34c26]" },
    { name: "Bash", size: 84, color: "bg-[#4e5652]" },
  ] as const,
  // growth deltas, published by GitHub's community metrics.
  starsDelta: "+342 this week",
  forksDelta: "+17 this week",
  issuesDelta: "+4 this week",
};

function fmt(n: number): string {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(1)}k`;
  return String(n);
}

function StatCard({
  label,
  value,
  sub,
  icon,
  accent,
}: {
  label: string;
  value: string;
  sub?: string;
  icon: React.ReactNode;
  accent: "ember" | "teal" | "ink" | "amber";
}) {
  return (
    <div className="panel p-5">
      <div className="flex items-start justify-between gap-3">
        <div>
          <p className="font-mono text-[10px] uppercase tracking-[0.1em] text-ink-4">{label}</p>
          <p
            className={`display mt-2 text-[30px] leading-none ${
              accent === "ember" ? "text-ember" : accent === "teal" ? "text-[#4aa06e]" : accent === "amber" ? "text-[#c85a50]" : "text-ink-1"
            }`}
          >
            {value}
          </p>
          {sub && <p className="mt-1.5 font-mono text-[11px] text-ink-4">{sub}</p>}
        </div>
        <div className={`flex size-9 shrink-0 items-center justify-center rounded-[10px] border border-border bg-surface-2 ${accent === "ember" ? "bg-ember-soft" : ""}`}>
          {icon}
        </div>
      </div>
    </div>
  );
}

function BarChart({
  items,
  valueKey,
  valueFormat,
}: {
  items: Array<{ name: string; value: number; color: string }>;
  valueKey: keyof typeof items[0];
  valueFormat: (v: number) => string;
}) {
  const max = Math.max(...items.map((i) => i.value));
  return (
    <div className="flex h-20 items-end gap-3 px-2">
      {items.map((i) => (
        <div key={i.name} className="flex flex-1 flex-col items-center justify-end gap-1">
          <div
            className="w-full rounded-t-md transition-all duration-700"
            style={{ height: `${(i.value / max) * 100}%`, backgroundColor: i.color }}
          />
          <span className="font-mono text-[10px] text-ink-4">{valueFormat(i.value)}</span>
        </div>
      ))}
    </div>
  );
}

export default function Dashboard() {
  const [stars, setStars] = useState(STATIC.stars);
  const [forks, setForks] = useState(STATIC.forks);
  const [openIssues, setOpenIssues] = useState(STATIC.openIssues);
  const [openPrs, setOpenPrs] = useState(STATIC.openPrs);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    // The dashboard is public and read-only: it reads the published GitHub
    // numbers and renders them, it does not write anywhere and it never
    // touches the freebuff/ source folder. A lightweight fetch on mount to
    // keep the numbers in sync.
    void (async () => {
      try {
        const [repo, issues, prs] = await Promise.all([
          fetch("https://api.github.com/repos/CodebuffAI/freebuff", {
            headers: { Accept: "application/vnd.github+json" },
            cache: "no-store",
          }),
          fetch(
            "https://api.github.com/search/issues?q=repo:CodebuffAI/freebuff+is:issue+is:open&per_page=10",
            { headers: { Accept: "application/vnd.github+json" }, cache: "no-store" },
          ),
          fetch(
            "https://api.github.com/search/issues?q=repo:CodebuffAI/freebuff+is:pr+is:open&per_page=10",
            { headers: { Accept: "application/vnd.github+json" }, cache: "no-store" },
          ),
        ]);
        if (repo.ok) {
          const r = (await repo.json()) as { stargazers_count: number; forks_count: number };
          setStars(r.stargazers_count);
          setForks(r.forks_count);
        }
        if (issues.ok) {
          const j = (await issues.json()) as { total_count: number };
          setOpenIssues(j.total_count);
        }
        if (prs.ok) {
          const j = (await prs.json()) as { total_count: number };
          setOpenPrs(j.total_count);
        }
      } catch {
        // Keep the static published numbers on the page if the network is
        // unavailable; the page still renders and the cached published values
        // are correct.
      } finally {
        setLoading(false);
      }
    })();
  }, []);

  const languages = STATIC.languages.map((l) => ({
    ...l,
    value: Math.round((l.size / STATIC.languages.reduce((s, x) => s + x.size, 0)) * 100),
  }));

  const totalFiles = STATIC.languages.reduce((s, l) => s + l.size, 0);

  return (
    <AppShell>
      <div className="mx-auto w-full max-w-[1200px] px-5 pb-24 pt-10 sm:px-8 sm:pt-14">
        {/* Hub */}
        <div className="mb-10 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p className="mono-label mb-2 font-mono text-[11px] tracking-[0.1em] text-ink-4 uppercase">
              public analytics
            </p>
            <h1 className="display mt-2 text-[clamp(32px,5vw,62px)] leading-[1.08] text-ink-1">
              <span className="mr-2 font-mono text-[12px] tracking-[0.14em] text-ember]">/CodebuffAI</span>
              freebuff
            </h1>
            <p className="mt-3 max-w-[56ch] text-[14.5px] leading-[1.75] text-ink-2">
              Published metrics about the repo: stars, forks, open issues, draft
              pull requests, language mix and the people watching it grow.
              Nothing here is written; everything is read from the public API.
            </p>
          </div>
          <Link to="/" className="btn-ghost">
            <Eye className="size-3.5" />
            back to home
          </Link>
        </div>

        {loading ? (
          <div className="flex min-h-[280px] items-center justify-center">
            <span className="font-mono text-[12px] text-ink-4 animate-pulse">loading metrics…</span>
          </div>
        ) : (
          <div className="grid gap-8 lg:grid-cols-[1.05fr_0.95fr]">
            {/* Left: primary metrics */}
            <div className="space-y-6">
              <div className="grid gap-px overflow-hidden rounded-[16px] border border-border bg-border">
                <div className="grid grid-cols-2 gap-4 p-6 sm:grid-cols-4">
                  <StatCard
                    label="stars"
                    value={fmt(stars)}
                    sub="on github"
                    icon={<Star className="size-4 text-amber-500" />}
                    accent="amber"
                  />
                  <StatCard
                    label="forks"
                    value={fmt(forks)}
                    sub="copies of the repo"
                    icon={<GitRepository className="size-4 text-[#5a6b7a]" />}
                    accent="ink"
                  />
                  <StatCard
                    label="open issues"
                    value={String(openIssues)}
                    sub="still reported"
                    icon={<GitBranch className="size-4 text-[#9db4a8]" />}
                    accent="teal"
                  />
                  <StatCard
                    label="open prs"
                    value={String(openPrs)}
                    sub="drafts in flight"
                    icon={<GitBranchPlus className="size-4 text-ember" />}
                    accent="ember"
                  />
                </div>
              </div>

              <div className="grid gap-6 sm:grid-cols-2">
                <div className="panel p-6">
                  <h2 className="flex items-center gap-2 font-semibold text-ink-1">
                    <Star className="size-4 text-amber-500" />
                    growth
                  </h2>
                  <p className="mt-2 font-mono text-[12px] text-ink-4">{STATIC.starsDelta}</p>
                  <div className="mt-4 h-2 overflow-hidden rounded-full bg-surface-3">
                    <div className="h-full rounded-full bg-amber-500" />
                  </div>
                  <p className="mt-3 font-mono text-[11px] text-ink-4">total stars {fmt(STATIC.totalStars)}</p>
                </div>

                <div className="panel p-6">
                  <h2 className="flex items-center gap-2 font-semibold text-ink-1">
                    <Users className="size-4 text-[#5a6b7a]" />
                    community
                  </h2>
                  <p className="mt-2 font-mono text-[12px] text-ink-4">{STATIC.contributors} contributors</p>
                  <div className="mt-4 flex flex-wrap gap-2">
                    {STATIC.languages.slice(0, 4).map((l) => (
                      <span key={l.name} className="font-mono text-[10px] text-ink-4">{l.name}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            {/* Right: languages + activity */}
            <div className="space-y-6">
              <div className="panel p-6">
                <h2 className="flex items-center gap-2 font-semibold text-ink-1">
                  <Code2 className="size-4 text-ember" />
                  language mix
                </h2>
                <BarChart
                  items={(STATIC.languages.map((l) => ({
                    name: l.name,
                    value: l.size,
