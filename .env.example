# Copy to .env for local development. Never commit .env or private keys.
NODE_ENV=development
PORT=8787
APP_URL=http://localhost:5173
STATIC_DIR=dist

# Local-only development database. Use a unique strong password in production.
DATABASE_URL=postgres://lolo:lolo@127.0.0.1:5432/lolo
AUTO_MIGRATE=true

# Comma-separated administrator emails. REQUIRED for production admin access.
# In production, the first public signup is always a regular user.
ADMIN_EMAILS=

SESSION_COOKIE=lolo_session
SESSION_TTL_HOURS=720
MAGIC_LINK_TTL_MINUTES=15

# Configure real email delivery to avoid printing sign-in links to server logs.
RESEND_API_KEY=
MAIL_FROM=Lolo <onboarding@resend.dev>

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=120000
OLLAMA_KEEPALIVE_MS=45000

# Real backend is the default; mock data is only an explicit development opt-in.
VITE_API_MODE=http
VITE_API_URL=http://localhost:8787
